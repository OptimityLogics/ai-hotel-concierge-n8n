        "jsCode": "const chat = $('Guest Chat').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.answer);\nconst knowledge = rows.length\n  ? rows.map(r => `[${r.topic}] ${r.answer}`).join('\\n\\n')\n  : 'NO HOTEL DATA AVAILABLE';\nreturn [{ json: { chatInput: chat.chatInput, sessionId: chat.sessionId, knowledge } }];"
